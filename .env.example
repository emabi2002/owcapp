# OWC Mobile/PWA runtime integration
#
# Leave blank for the local demonstration fallback.
# For live operation set this to the public OWC application/API origin, for example:
# NEXT_PUBLIC_OWC_API_BASE_URL=https://owc.gov.pg
#
# This is a browser-visible build-time variable. Never place CPPS, Drupal,
# Supabase service-role, banking, identity-provider, or other secrets here.
NEXT_PUBLIC_OWC_API_BASE_URL=
