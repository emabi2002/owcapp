# Server-only base URL of the authoritative OWC portal/API.
# Do not expose this value through NEXT_PUBLIC_*.
OWC_API_BASE_URL="http://localhost:3000"

# Optional non-secret presentation/offline fallback for public news/forms only.
# Keep false for normal UAT/production operation.
NEXT_PUBLIC_OWC_PUBLIC_CONTENT_FALLBACK="false"
